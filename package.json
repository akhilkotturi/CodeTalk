{
  "name": "CodeTalk",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time incident war room for hackathon/project teams. Learning project: microservices, Kong, JWT, WS load balancing, MCP.",
  "workspaces": [
    "apps/*",
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:incident-service": "npm run dev -w services/incident-service",
    "dev:notification-service": "npm run dev -w services/notification-service",
    "dev:snippet-service": "npm run dev -w services/snippet-service",
    "dev:ws-gateway": "npm run dev -w services/ws-gateway",
    "dev:web": "npm run dev -w apps/web",
    "test:web": "npm run test -w apps/web",
    "test:e2e": "jest --config e2e/jest.config.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
