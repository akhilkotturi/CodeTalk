# Backend auth/session
JWT_SECRET=replace-with-a-long-random-secret
SERVICE_TOKEN=replace-with-an-internal-service-token

# GitHub OAuth App
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_REDIRECT_URI=https://your-api-host.example.com/auth/github/callback
FRONTEND_URL=https://your-web-host.example.com
# Optional: raises GitHub API limits when syncing repository activity.
GITHUB_TOKEN=

# Frontend build/dev config
VITE_API_BASE_URL=https://your-api-host.example.com
VITE_WS_BASE_URL=wss://your-api-host.example.com
VITE_DEV_API_PROXY_TARGET=https://your-api-host.example.com

# Local-only escape hatch for old anonymous dev-token flow. Leave false outside local tests.
ALLOW_DEV_AUTH=false
