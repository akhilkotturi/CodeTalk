# Backend auth/session
JWT_SECRET=replace-with-a-long-random-secret
SERVICE_TOKEN=replace-with-an-internal-service-token

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:5173
# Optional: raises GitHub API limits when syncing repository activity.
GITHUB_TOKEN=

# Frontend build/dev config
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Local-only escape hatch for old anonymous dev-token flow. Leave false outside local tests.
ALLOW_DEV_AUTH=false
